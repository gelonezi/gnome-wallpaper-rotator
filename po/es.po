#: prefs.js:257
msgid "Notify on Download Error"
msgstr "Notificar error de descarga"

#: prefs.js:258
msgid ""
"Displays a notification with error message and option to retry download."
msgstr ""
"Muestra una notificación con un mensaje de error y una opción para volver a "
"intentar la descarga."

#: prefs.js:274
msgid "Image Resolution"
msgstr "Resolución de la imagen"

#. TRANSLATORS: Markets are specific regions, defined by their language codes.
